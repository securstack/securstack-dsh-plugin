{
  "name": "@securstack/dsh-plugin",
  "version": "0.1.2",
  "description": "DeepSeek Harness plugin for SecurStack security scans, policy checks, doctor diagnostics, and JSON CLI results.",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "securstack",
    "security",
    "ai-agent",
    "sast",
    "sca",
    "dast",
    "secrets",
    "iac",
    "policy-as-code",
    "devsecops"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --deps.never-bundle @deepseek-ai/dsh-tools --deps.never-bundle @deepseek-ai/cordis",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^22.15.30",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/securstack/securstack-dsh-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
